{
  "name": "@omadia/channel-teams",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "package": "node scripts/build-zip.mjs",
    "clean": "rm -rf dist out *.tsbuildinfo"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.88.0",
    "@omadia/channel-sdk": "*",
    "@omadia/diagrams": "*",
    "@omadia/integration-microsoft365": "*",
    "@omadia/orchestrator": "*",
    "@omadia/plugin-api": "*",
    "@omadia/plugin-ui-helpers": "*",
    "botbuilder": "^4.23.3",
    "express": "^5.0.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "typescript": "^6.0.2",
    "@types/node": "^25.6.0",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.11.10",
    "@anthropic-ai/sdk": "^0.88.0",
    "botbuilder": "^4.23.3",
    "express": "^5.0.0",
    "pg": "^8.13.0",
    "esbuild": "^0.24.0",
    "@omadia/plugin-api": "file:../odoo-bot/middleware/packages/plugin-api",
    "@omadia/channel-sdk": "file:../odoo-bot/middleware/packages/harness-channel-sdk",
    "@omadia/diagrams": "file:../odoo-bot/middleware/packages/harness-diagrams",
    "@omadia/plugin-ui-helpers": "file:../odoo-bot/middleware/packages/harness-ui-helpers"
  },
  "engines": {
    "node": ">=20"
  },
  "description": "Microsoft Teams channel plugin for Omadia. Implements @omadia/channel-sdk's ChannelPlugin contract: Bot-Framework adapter, Adaptive-Card rendering, roster + mention resolution, attachment persistence with signed-URL proxy, and HTTP routes for /api/messages + /attachments. Depends on @omadia/integration-microsoft365 for shared Graph client and App-registration credentials.",
